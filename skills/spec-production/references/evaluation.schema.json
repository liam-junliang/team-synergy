{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specification production review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_version",
    "source_manifest_sha256",
    "reviewed_keys",
    "not_checked",
    "findings",
    "verdict"
  ],
  "properties": {
    "skill_version": {
      "type": "string"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "not_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "needs_revision",
        "needs_review",
        "reviewed_with_limits"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "item_key",
          "claim",
          "evidence",
          "suggestion"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "warning",
              "needs_review"
            ]
          },
          "item_key": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "line_start",
                "line_end"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    }
  }
}
