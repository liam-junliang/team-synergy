{
  "name": "@team-synergy/core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs && node scripts/bundle-system-agent-skill.mjs && node scripts/bundle-platform-skill.mjs && node scripts/bundle-connector-skill.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs -- node --test --test-concurrency=1 tests/*.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.4.1",
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@team-synergy/application": "workspace:*",
    "@team-synergy/contracts": "workspace:*",
    "@team-synergy/domain": "workspace:*",
    "@team-synergy/integrations": "workspace:*",
    "@team-synergy/persistence": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "prom-client": "^15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
