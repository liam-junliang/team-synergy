    "@team-synergy/domain": "workspace:*",
    "@team-synergy/persistence": "workspace:*",
    "@fastify/swagger": "^9.4.1",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
