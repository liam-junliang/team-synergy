# Server-private configuration, mounted through Compose env_file.
# Enable memory in server.env only after its data, identities and model are ready.
# TSP_MEMORY_ENGINES_FILE=/run/team-synergy/engines.json
# NODE_EXTRA_CA_CERTS=/run/team-synergy/internal-ca.crt
# TSP_MEMORY_BASE_URL=https://model.private.example/v1
# Model API keys belong here or in server-private mounted files, never in Git.
# Optional remote Connector. Use the same public HTTPS origin as TSP_WEB_ORIGIN.
# TSP_REMOTE_MCP_URL=https://workspace.example.com/api/mcp
