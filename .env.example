# PostgreSQL connection used by Core API
TSP_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/team_synergy

# Isolated database for the test suites (never point this at the development database)
TSP_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/team_synergy_test

# System Agent V1 (disabled until explicitly configured). Pinned DSH: 0.2.1-rc.2.
# The Windows launcher also accepts TSP_SYSTEM_AGENT_CONFIG_FILE (paths/settings JSON only).
# Install the requested runtime separately; point at its absolute @deepseek-ai/dsh/lib/bin.js.
TSP_SYSTEM_AGENT_ENABLED=false
TSP_SYSTEM_AGENT_DSH_BIN=
# Must be outside service/source and personal user-space; never use the repository as a job cwd.
TSP_SYSTEM_AGENT_WORKSPACE_ROOT=
TSP_SYSTEM_AGENT_MODEL=deepseek-flash
# Explicit secret source; never commit credentials. Existing DSH managed YAML is supported.
TSP_SYSTEM_AGENT_DSH_CREDENTIALS_FILE=
# Alternatively supply TSP_SYSTEM_AGENT_API_KEY or TSP_SYSTEM_AGENT_API_KEY_FILE to the process.
TSP_SYSTEM_AGENT_TIMEOUT_MS=180000
TSP_SYSTEM_AGENT_MAX_TOKENS=16384
