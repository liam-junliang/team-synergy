# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22.23.5-bookworm-slim
ARG NGINX_IMAGE=nginx:1.30.6-alpine
FROM ${NODE_IMAGE} AS build
WORKDIR /source
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
RUN --mount=type=cache,id=tsp-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store
RUN pnpm --filter @team-synergy/web... build

FROM ${NGINX_IMAGE} AS runtime
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/liam-junliang/team-synergy" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
ENV TSP_API_PORT=8080 TSP_WEB_PORT=8088
COPY --from=build /source/apps/web/dist /usr/share/nginx/html
COPY deploy/containers/nginx.conf.template /etc/nginx/tsp.conf.template
COPY --chmod=755 deploy/containers/web-entrypoint.sh /usr/local/bin/tsp-web
USER nginx
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${TSP_WEB_PORT}/"
ENTRYPOINT ["/usr/local/bin/tsp-web"]
